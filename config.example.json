{
  "lichess": {
    "token": "{env:LICHESS_TOKEN}",
    "user_agent": "llm-chess-bot/0.1 (contact: you@example.com)"
  },

  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "http://localhost:4000/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "gpt-4o": { "name": "GPT-4o" }
      }
    }
  },
  "model": "litellm/gpt-4o",

  "challenges": {
    "variants": ["standard"],
    "min_initial_seconds": 300,
    "min_increment_seconds": 0,
    "allow_correspondence": false,
    "allow_rated": false,
    "allow_casual": true,
    "allow_bots": false
  },

  "bot": {
    "max_games": 1,
    "persona": "You are a friendly, talkative chess player who enjoys explaining ideas.",
    "max_think_seconds": 60,
    "chat_memory": 40,
    "move_retries": 2,
    "greet": true
  },

  "openings": {
    "white": {
      "name": "Italian Game, Giuoco Piano",
      "moves": "1. e4 e5 2. Nf3 Nc6 3. Bc4 Bc5 4. c3 Nf6 5. d4",
      "instructions": "Aim for open, attacking positions."
    },
    "black": {
      "instructions": "Choose a solid defence against stronger opponents and a sharp one against weaker opponents."
    }
  },
  "openings_file": "",

  "log": { "level": "info", "format": "json" }
}
